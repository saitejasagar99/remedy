{
  "name": "remedy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "test:hindsight": "vitest run --project hindsight",
    "verify:memory": "tsx --env-file=.env scripts/verify-memory.ts",
    "diagnose": "tsx --env-file=.env scripts/diagnose-recommend.ts",
    "diagnose:arms": "tsx --env-file=.env scripts/diagnose-arms.ts",
    "seed": "tsx --env-file=.env scripts/seed-memory.ts",
    "samples": "tsx scripts/load-samples.ts",
    "warm": "tsx scripts/warm-workspace.ts",
    "hindsight:start": "powershell -ExecutionPolicy Bypass -File scripts/hindsight-start.ps1"
  },
  "dependencies": {
    "@vectorize-io/hindsight-client": "^0.10.1",
    "better-sqlite3": "^13.0.3",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
