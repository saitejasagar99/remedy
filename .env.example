# ---------------------------------------------------------------------------
# REMEDY configuration - copy to .env. NEVER commit .env; it is gitignored.
#
# Everything below is LOCAL DEVELOPMENT configuration. Production (Render)
# reads the same variable names from the Render dashboard; see the section at
# the bottom for the rules. No real credential belongs in this file.
# ---------------------------------------------------------------------------

# --- Hindsight memory layer (local bare-metal server) ----------------------
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_TENANT=default
HINDSIGHT_BANK=remedy
# Optional locally (self-hosted ignores it). REQUIRED in production: Hindsight
# Cloud rejects unauthenticated calls. Keep the value only in the dashboard.
HINDSIGHT_API_KEY=

# Timeouts (ms) - a hung memory server must never hang a request.
# Retain runs local fact extraction, the slowest call in the product, so it
# gets the most headroom.
HINDSIGHT_RETAIN_TIMEOUT_MS=120000
HINDSIGHT_RECALL_TIMEOUT_MS=60000

# --- LLM (OpenAI-compatible; Ollama by default) ---------------------------
# The app appends /chat/completions itself, so LLM_BASE_URL must be the base
# path the provider expects, including its version segment when it uses one
# (for example https://<your-provider-host>/v1).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma3:4b
LLM_API_KEY=ollama
LLM_TIMEOUT_MS=120000
LLM_TEMPERATURE=0.2

# --- Application state (SQLite) -------------------------------------------
# Relative path: resolved against the project root, no machine-specific path.
DATABASE_PATH=./data/remedy.db

# ===========================================================================
# PRODUCTION (Render)
# ===========================================================================
# Set the real values in the Render dashboard (Environment tab). render.yaml
# already carries the non-secret ones; secrets are reserved there as
# `sync: false` and must be pasted in as dashboard-only values.
#
# Rules enforced by src/lib/config.ts when NODE_ENV=production:
#   * HINDSIGHT_URL and LLM_BASE_URL must be EXPLICITLY supplied - the
#     localhost development defaults above are not used.
#   * Neither may point at localhost / 127.0.0.1 / ::1; requests are refused
#     with a clear configuration error instead of silently dialling localhost.
#
# Confirmed non-secret values (also set in render.yaml):
#   HINDSIGHT_URL=https://api.hindsight.vectorize.io   # Hindsight Cloud
#   HINDSIGHT_TENANT=default
#   HINDSIGHT_BANK=remedy
#
# Still to be provided as dashboard values (no provider is configured in this
# repository - a cloud LLM provider still needs to be selected and its
# credentials added in Render):
#   LLM_BASE_URL=          # REQUIRED: read at build time by `next build`,
#                          # so set it before the first deploy succeeds.
#   LLM_MODEL=             # model name that provider exposes.
#   LLM_API_KEY=           # SECRET, if the provider requires one.
#   HINDSIGHT_API_KEY=     # SECRET, required for Hindsight Cloud.
#
# Secrets (dashboard only, never in render.yaml or git):
#   HINDSIGHT_API_KEY, LLM_API_KEY
#
# SQLite persistence: the Render Free plan has no disk, so storage is
# EPHEMERAL. DATABASE_PATH stays environment-driven (default ./data/remedy.db)
# and no disk is attached by render.yaml - findings, approvals and run history
# in SQLite do NOT survive redeploys or instance recreation. Organisational
# memory itself lives in Hindsight and is unaffected.
